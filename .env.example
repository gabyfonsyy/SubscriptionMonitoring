# Copy to .env.local and fill in. NEVER commit .env.local.
# Placeholder values only.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by cron/notification code only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL, used for links inside notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only Google accounts on this domain may sign in.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=sprout.ph
# Dev convenience: email/password sign-in on the login page. Keep "false" in production.
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=true

# --- Notifications (server-only, optional) ---
# Leave empty to run without notifications; the portal shows "not configured".
GOOGLE_CHAT_WEBHOOK_URL=
# Shared secret that Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
